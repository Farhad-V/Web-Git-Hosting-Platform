@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 13 - Observability Testing
top to bottom direction
rectangle "Observability Testing" as Topic
rectangle "Health and readiness behavior" as N0
Topic --> N0
rectangle "Database, Git and storage readiness" as N1
Topic --> N1
rectangle "Request identifiers where implemented" as N2
Topic --> N2
rectangle "Structured logs and failure context" as N3
Topic --> N3
rectangle "Secrets excluded from operational evidence" as N4
Topic --> N4

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
@enduml
