@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 40 - Testing Metrics
top to bottom direction
rectangle "Testing Metrics" as Topic
rectangle "Planned, executed and not-executed cases" as N0
Topic --> N0
rectangle "Passed, failed and blocked cases" as N1
Topic --> N1
rectangle "Defects by severity and open blockers" as N2
Topic --> N2
rectangle "Corrected and retested defects" as N3
Topic --> N3
rectangle "Requirements and acceptance coverage" as N4
Topic --> N4
rectangle "Critical coverage matters beyond pass\npercentage" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
