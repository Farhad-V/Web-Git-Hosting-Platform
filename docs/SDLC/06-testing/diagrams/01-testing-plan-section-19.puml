@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 19 - Test Data
top to bottom direction
rectangle "Test Data" as Topic
rectangle "Non-production owners and non-owners" as N0
Topic --> N0
rectangle "Public and private repositories" as N1
Topic --> N1
rectangle "Valid, invalid and revoked tokens" as N2
Topic --> N2
rectangle "Valid and invalid refs" as N3
Topic --> N3
rectangle "Reproducible trees, files and commits" as N4
Topic --> N4
rectangle "Disposable fixtures; no committed secrets" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
