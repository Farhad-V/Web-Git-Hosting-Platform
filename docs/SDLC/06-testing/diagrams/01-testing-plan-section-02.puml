@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 02 - Testing Objective
top to bottom direction
rectangle "Testing Objective" as Topic
rectangle "Functional and non-functional requirements" as N0
Topic --> N0
rectangle "Authorization and private repository\nprotection" as N1
Topic --> N1
rectangle "Storage containment and safe Git execution" as N2
Topic --> N2
rectangle "Git clone, fetch, push and PAT\nauthentication" as N3
Topic --> N3
rectangle "Integrated UI, API and database behavior" as N4
Topic --> N4
rectangle "No unresolved release-blocking defects" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
