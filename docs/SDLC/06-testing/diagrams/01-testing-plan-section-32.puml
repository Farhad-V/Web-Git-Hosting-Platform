@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 32 - M5 Exit Criteria
top to bottom direction
rectangle "M5 Exit Criteria" as Topic
rectangle "Required work packages complete" as N0
Topic --> N0
rectangle "Required functional and integration\nevidence passes" as N1
Topic --> N1
rectangle "Security and Git transport verified" as N2
Topic --> N2
rectangle "Regression and acceptance complete" as N3
Topic --> N3
rectangle "Traceability and evidence complete" as N4
Topic --> N4
rectangle "No release blockers; milestone review\napproved" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
