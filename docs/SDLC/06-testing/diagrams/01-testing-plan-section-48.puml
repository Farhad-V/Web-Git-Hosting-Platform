@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 48 - Historical M5 Planning Status
top to bottom direction
rectangle "Historical M5 Planning Status" as Topic
rectangle "Historical planning snapshot: M5 IN\nPROGRESS" as N0
Topic --> N0
rectangle "M4 completed, approved and merged" as N1
Topic --> N1
rectangle "testing/m5 and documentation directory\ncreated" as N2
Topic --> N2
rectangle "WP-01 Testing Plan approved" as N3
Topic --> N3
rectangle "Planning-time next step: WP-02\nspecification" as N4
Topic --> N4
rectangle "Later closure recorded in M5 milestone\nreview" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
