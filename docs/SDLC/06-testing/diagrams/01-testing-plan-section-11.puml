@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 11 - Database Testing
top to bottom direction
rectangle "Database Testing" as Topic
rectangle "Migration state and required schema" as N0
Topic --> N0
rectangle "Indexes and unique constraints" as N1
Topic --> N1
rectangle "Foreign keys and ownership relationships" as N2
Topic --> N2
rectangle "Visibility and PAT persistence" as N3
Topic --> N3
rectangle "Cascade or restriction behavior" as N4
Topic --> N4
rectangle "Repository data consistency" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
