@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 22 - Test Evidence
top to bottom direction
rectangle "Test Evidence" as Topic
rectangle "Automated and command output" as N0
Topic --> N0
rectangle "API responses and Git CLI results" as N1
Topic --> N1
rectangle "Database inspection and browser\nobservations" as N2
Topic --> N2
rectangle "Test-case outcomes and screenshots where\nuseful" as N3
Topic --> N3
rectangle "Defect, retest and regression records" as N4
Topic --> N4
rectangle "Traceable acceptance evidence" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
