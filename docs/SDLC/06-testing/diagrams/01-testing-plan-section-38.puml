@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 38 - Risk-Based Testing Priorities
top to bottom direction
rectangle "Risk-Based Testing Priorities" as Topic
rectangle "Priority 1: identity, policy and private\nprotection" as N0
Topic --> N0
rectangle "Priority 1: containment, injection and\npush authorization" as N1
Topic --> N1
rectangle "Priority 2: metadata, browsing and Git\nworkflows" as N2
Topic --> N2
rectangle "Priority 2: API validation and database\nintegrity" as N3
Topic --> N3
rectangle "Priority 3: usability, observability and\ndeployment checks" as N4
Topic --> N4
rectangle "All required tests remain in scope" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
