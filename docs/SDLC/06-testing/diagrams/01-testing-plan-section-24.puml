@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 24 - M5 Work Packages
top to bottom direction
rectangle "M5 Work Packages" as Topic
rectangle "WP-01–03: plan, cases and environment" as N0
Topic --> N0
rectangle "WP-04–06: authentication, metadata and\npolicy" as N1
Topic --> N1
rectangle "WP-07–09: storage, Git process and browser" as N2
Topic --> N2
rectangle "WP-10–12: read transport, PAT and write\ntransport" as N3
Topic --> N3
rectangle "WP-13–16: UI, security, failure and system\ntests" as N4
Topic --> N4
rectangle "WP-17–19: regression, acceptance and\ntraceability" as N5
Topic --> N5
rectangle "WP-20–21: validation and milestone review" as N6
Topic --> N6

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
N5 -[hidden]down-> N6
@enduml
