@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title 03 - Testing Scope
top to bottom direction
rectangle "Testing Scope" as Topic
rectangle "Functional, API and database verification" as N0
Topic --> N0
rectangle "Authentication, authorization and PAT\ntests" as N1
Topic --> N1
rectangle "Repository metadata, storage and browser\ntests" as N2
Topic --> N2
rectangle "Git process and Smart HTTP read/write\ntests" as N3
Topic --> N3
rectangle "Frontend, failure and observability tests" as N4
Topic --> N4
rectangle "Security, regression, acceptance and\ntraceability" as N5
Topic --> N5

N0 -[hidden]down-> N1
N1 -[hidden]down-> N2
N2 -[hidden]down-> N3
N3 -[hidden]down-> N4
N4 -[hidden]down-> N5
@enduml
