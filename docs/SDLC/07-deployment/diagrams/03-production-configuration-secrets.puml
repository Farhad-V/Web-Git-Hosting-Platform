@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
skinparam shadowing false
title Secret provisioning and configuration lifecycle
start
:Select reviewed candidate templates;
:Create restricted deployed backend/.env;
:Inject host-specific database credentials and URLs;
if (First installation?) then (yes)
 :Generate unique APP_KEY;
else (upgrade)
 :Preserve existing APP_KEY;
endif
:Validate production flags and paths;
:Rebuild configuration and route caches;
:Restart affected long-lived processes;
:Verify runtime without exposing secret values;
stop
@enduml
