@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - Personal Access Token Use Cases
left to right direction
actor "Authenticated User" as User
actor "Git Client" as Client
rectangle "Personal Access Token Management" {
    usecase "UC-020\nCreate Personal Access Token" as Create
    usecase "UC-021\nAuthenticate Git Request\nwith PAT" as Authenticate
    usecase "UC-022\nRevoke Personal Access Token" as Revoke
}
User --> Create
User --> Revoke
Client --> Authenticate
@enduml
