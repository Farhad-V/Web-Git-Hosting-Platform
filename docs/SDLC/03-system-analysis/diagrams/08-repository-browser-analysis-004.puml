@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - File Viewing Activity
start
:Receive file-view request;
:Resolve repository;
:Authorize read;
if (Authorized?) then (yes)
    :Resolve reference;
    :Validate logical file path;
    if (Path resolves to blob?) then (yes)
        :Read blob content;
        :Classify presentation type;
        :Return safe representation;
    else (no)
        :Return safe not-found result;
    endif
else (no)
    :Deny;
endif
stop
@enduml
