@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - Git Read Failure Flow
start
:Receive Git read request;
if (Authentication required?) then (yes)
    :Authenticate PAT;
    if (Authentication succeeds?) then (yes)
    else (no)
        :Deny;
        stop
    endif
endif
:Resolve repository;
if (Repository resolved?) then (yes)
    :Authorize read;
    if (Allowed?) then (yes)
        :Resolve physical storage;
        if (Storage available?) then (yes)
            :Execute git-upload-pack;
            if (Git read succeeds?) then (yes)
                :Return Git response;
            else (no)
                :Return safe Git-read failure;
            endif
        else (no)
            :Return safe storage failure;
        endif
    else (no)
        :Deny;
    endif
else (no)
    :Return safe repository failure;
endif
stop
@enduml
