@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - AM-026 Repository Storage State Evaluation
start
:Resolve expected physical repository;
if (Repository exists?) then (yes)
    if (Repository usable?) then (yes)
        :State = Available;
    else (no)
        if (Repository corrupt?) then (yes)
            :State = Corrupt;
        else (no)
            :State = Unavailable;
        endif
    endif
else (no)
    :State = Missing;
endif
stop
@enduml
