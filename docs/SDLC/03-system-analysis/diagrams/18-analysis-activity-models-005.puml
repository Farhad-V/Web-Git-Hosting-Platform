@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - AM-005 List Owned Repositories
start
:Receive list-owned-repositories request;
if (User authenticated?) then (yes)
    :Resolve authenticated User identity;
    :Query repositories owned by User;
    if (Persistence operation succeeds?) then (yes)
        :Return repository metadata list;
    else (no)
        :Return safe persistence failure;
    endif
else (no)
    :Deny request;
endif
stop
@enduml
