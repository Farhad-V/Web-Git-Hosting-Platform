@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - Visibility Management Authorization
start
:Receive visibility change request;
:Resolve authenticated User;
:Resolve repository;
if (Caller owns repository?) then (yes)
    :Authorize management operation;
    :Apply valid visibility transition;
else (no)
    :Deny;
endif
stop
@enduml
