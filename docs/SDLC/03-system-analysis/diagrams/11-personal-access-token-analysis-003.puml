@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - PAT Authentication Activity
start
:Receive presented PAT;
:Locate candidate PAT record;
if (Candidate exists?) then (yes)
    :Verify presented PAT;
    if (Verification succeeds?) then (yes)
        :Check revocation state;
        if (Revoked?) then (yes)
            :Authentication denied;
        else (no)
            :Resolve owning User;
            :Establish authenticated identity;
        endif
    else (no)
        :Authentication denied;
    endif
else (no)
    :Authentication denied;
endif
stop
@enduml
