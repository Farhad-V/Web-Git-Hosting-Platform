@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - AM-021 Git Write-Service Discovery
start
:Receive git-receive-pack discovery request;
:Authenticate PAT;
if (Authentication succeeds?) then (yes)
    :Resolve repository;
    if (Repository exists?) then (yes)
        :Authorize owner write;
        if (Authorized?) then (yes)
            :Resolve safe physical repository;
            if (Storage available?) then (yes)
                :Execute approved write-service discovery;
                if (Discovery succeeds?) then (yes)
                    :Return Git service advertisement;
                else (no)
                    :Return Git discovery failure;
                endif
            else (no)
                :Return storage failure;
            endif
        else (no)
            :Deny write service;
        endif
    else (no)
        :Return repository-resolution failure;
    endif
else (no)
    :Deny authentication;
endif
stop
@enduml
