@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - Logical System Decomposition
left to right direction
actor "Web Client" as Web
actor "Git Client" as GitClient
rectangle "GitForge Logical System" {
    rectangle "Web Interaction" as WebInteraction
    rectangle "Identity & Web Authentication" as WebAuth
    rectangle "Repository Management" as RepoMgmt
    rectangle "Repository Authorization" as Authz
    rectangle "Repository Browser" as Browser
    rectangle "PAT Management" as PAT
    rectangle "Git Smart HTTP Interface" as GitHTTP
    rectangle "Git Authentication" as GitAuth
    rectangle "Git Read Coordination" as GitRead
    rectangle "Git Write Coordination" as GitWrite
    rectangle "Repository Storage Coordination" as Storage
    rectangle "Git Process Coordination" as GitProcess
    rectangle "Application Data Persistence" as Persistence
    rectangle "Validation" as Validation
    rectangle "Failure & Exception Handling" as Failure
    rectangle "Diagnostics & Logging" as Diagnostics
}
database PostgreSQL
folder "Repository Filesystem" as RepoFS
rectangle "Git Executable" as Git
Web --> WebInteraction
GitClient --> GitHTTP
WebInteraction --> WebAuth
WebInteraction --> RepoMgmt
WebInteraction --> Browser
WebInteraction --> PAT
RepoMgmt --> Authz
Browser --> Authz
GitHTTP --> GitAuth
GitHTTP --> GitRead
GitHTTP --> GitWrite
GitRead --> Authz
GitWrite --> Authz
RepoMgmt --> Persistence
PAT --> Persistence
WebAuth --> Persistence
Authz --> Persistence
RepoMgmt --> Storage
Browser --> Storage
GitRead --> Storage
GitWrite --> Storage
Browser --> GitProcess
GitRead --> GitProcess
GitWrite --> GitProcess
Storage --> GitProcess
Persistence --> PostgreSQL
Storage --> RepoFS
GitProcess --> Git
Git --> RepoFS
Validation ..> WebInteraction
Validation ..> RepoMgmt
Validation ..> GitHTTP
Validation ..> PAT
Failure ..> RepoMgmt
Failure ..> Browser
Failure ..> GitRead
Failure ..> GitWrite
Failure ..> GitProcess
Failure ..> Persistence
Diagnostics ..> Failure
@enduml
