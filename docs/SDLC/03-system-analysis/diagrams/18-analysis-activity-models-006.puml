@startuml
title GitForge V1.0.0 - AM-006 Repository Read Authorization
start
:Receive repository read context;
:Resolve repository metadata;
if (Repository exists?) then (yes)
    if (Visibility is Public?) then (yes)
        :Allow read;
    else (no)
        if (Caller authenticated?) then (yes)
            if (Caller is repository owner?) then (yes)
                :Allow read;
            else (no)
                :Deny read;
            endif
        else (no)
            :Deny read;
        endif
    endif
else (no)
    :Return repository-resolution failure;
endif
stop
@enduml
