@startuml
title GitForge V1.0.0 - SM-017 PAT Revocation
actor "Authenticated User" as User
participant "Web/API Interface" as Web
participant "PAT Coordination" as PAT
database PostgreSQL as DB
participant "Failure Handling" as Failure
User -> Web : Revoke PAT
Web -> PAT : PAT ID + authenticated User
PAT -> DB : Resolve PAT
DB --> PAT : PAT metadata + owner
alt User owns PAT
    PAT -> DB : Persist revoked state
    alt Persistence succeeds
        DB --> PAT : Revoked
        PAT --> Web : Success
        Web --> User : PAT revoked
    else Persistence fails
        DB --> PAT : Failure
        PAT -> Failure : Revocation persistence failure
        Failure --> Web : Safe failure
        Web --> User : Revocation failed
    end
else User does not own PAT
    PAT --> Web : Deny
    Web --> User : Safe denial
end
@enduml
