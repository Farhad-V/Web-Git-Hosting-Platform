@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - AM-032 Private Read by Non-Owner
start
:Resolve private repository;
:Resolve authenticated User identity;
if (User is owner?) then (yes)
    :Allow read;
    :Continue to storage resolution;
else (no)
    :Deny read;
    :Stop before protected Git content access;
endif
stop
@enduml
