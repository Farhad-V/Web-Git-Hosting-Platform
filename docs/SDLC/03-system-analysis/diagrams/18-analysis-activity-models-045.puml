@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - AM-045 Concurrent Repository Creation
start
:Request creation of <owner>/<repository>;
:Check namespace availability;
if (Namespace available?) then (yes)
    :Attempt authoritative repository creation;
    if (Uniqueness still holds at persistence?) then (yes)
        :Complete valid creation;
    else (no)
        :Reject concurrent namespace conflict;
    endif
else (no)
    :Reject duplicate namespace;
endif
stop
@enduml
