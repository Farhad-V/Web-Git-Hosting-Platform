@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - AM-012 Commit Details
start
:Receive repository + commit identifier;
:Resolve repository;
:Authorize read;
if (Allowed?) then (yes)
    :Resolve safe physical repository;
    :Resolve commit identifier;
    if (Commit exists?) then (yes)
        :Read commit data;
        if (Git read succeeds?) then (yes)
            :Return safe commit representation;
        else (no)
            :Return Git-read failure;
        endif
    else (no)
        :Return commit-not-found result;
    endif
else (no)
    :Deny read;
endif
stop
@enduml
