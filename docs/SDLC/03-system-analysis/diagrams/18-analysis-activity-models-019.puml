@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #172033
skinparam backgroundColor #FFFFFF
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam noteFontSize 14
title GitForge V1.0.0 - AM-019 Private Git Smart HTTP Read
start
:Receive Git read request + PAT;
:Authenticate PAT;
if (Authentication succeeds?) then (yes)
    :Resolve repository;
    if (Repository exists?) then (yes)
        :Authorize read;
        if (Authenticated User is owner?) then (yes)
            :Resolve safe physical repository;
            if (Storage available?) then (yes)
                :Execute approved git-upload-pack operation;
                if (Git read succeeds?) then (yes)
                    :Stream Git response;
                else (no)
                    :Return Git-read failure;
                endif
            else (no)
                :Return storage failure;
            endif
        else (no)
            :Deny read;
        endif
    else (no)
        :Return repository-resolution failure;
    endif
else (no)
    :Deny authentication;
endif
stop
@enduml
